      "name": "CCRT 评价结果",
      "kind": "json_list",
      "config": {
        "url": "https://www.c-ncap.org.cn/api/getPingjiaList",
        "method": "POST",
        "bodyJson": { "type": "ccrt", "size": 20, "current": 1 },
        "itemsPath": "data.data.records",
