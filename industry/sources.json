{
  “$comment”: “车载行业信源：首次启动时导入（scripts/seed.ts），已存在的不会被覆盖，之后在后台”信源”里增删改。字段说明见 docs/customize.md。2026-10-08 全部启用：json-sac-gb / json-miit-zcwj / rss-euroncap-news / json-cncap-pingjia 早在 2026-09-30 试抓通过；json-cncap-cgcaps / json-cncap-cicaps / json-cncap-ccrt 接口同日验证（各 20 条、日期齐全）；web-catarc-news 端点活着但首页列表偏走访/党建动态，启用后需观察噪声；web-catarc-wp29 最新条目停在 2024-03-18，启用后无新内容时不产生条目。待接入信源见 regdocs/05-信源接入计划.md。需要真实浏览器的站点（EUR-Lex、IVISTA、国家标准委 bzhdt）走 POST /api/ingest/items。”,
  "sources": [
    {
      "id": "json-sac-gb",
      "name": "国家标准全文公开系统 · 汽车",
      "kind": "json_list",
      "config": {
        "url": "https://std.samr.gov.cn/gb/search/gbQueryPage?searchText=%E6%B1%BD%E8%BD%A6&pageSize=25",
        "itemsPath": "rows",
        "titlePaths": ["C_C_NAME"],
        "summaryPaths": ["C_STD_CODE"],
        "urlTemplate": "https://std.samr.gov.cn/gb/search/gbDetailed?id={id}",
        "externalIdPath": "id",
        "publishedAtPath": "ISSUE_DATE",
        "requireBoolean": { "path": "STATE", "equals": "现行" },
        "_aihot": { "initialBackfillLimit": 20 }
      },
      "tier": "T1",
      "first_party": true,
      "owner_entity_id": "samr-sac",
      "participation_mode": "editorial",
      "interval_minutes": 180,
      "tags": ["官方", "标准"],
      "site_fulltext": false,
      "syndicate_fulltext": false,
      "enabled": true
    },
    {
      "id": "json-miit-zcwj",
      "name": "工业和信息化部 · 政策文件（汽车）",
      "kind": "json_list",
      "config": {
        "url": "https://www.miit.gov.cn/search-front-server/api/search/info?websiteid=110000000000000&scope=basic&q=%E6%B1%BD%E8%BD%A6&pg=20&p=1&dateField=deploytime&selectFields=title,content,deploytime,url,cdate,columnname,publishtime,metaid&group=distinct&level=6&sortFields=%5B%7B%22name%22%3A%22deploytime%22%2C%22type%22%3A%22desc%22%7D%5D&highlightFields=title_text%2Cinfocontent%2Cwebid",
        "itemsPath": "data.searchResult.dataResults",
        "titlePaths": ["groupData.0.data.title"],
        "urlTemplate": "https://www.miit.gov.cn{groupData.0.data.url}",
        "externalIdPath": "groupData.0.pkValue",
        "publishedAtPath": "groupData.0.data.deploytime",
        "publishedAtUnit": "epoch_ms",
        "sortByPublishedAt": true,
        "ingestNoiseFilter": {
          "keepIfMatches": ["汽车", "车辆", "智能网联", "自动驾驶", "动力电池", "软件升级"],
          "dropMarkersTitleOnly": ["通信管理局", "增值电信业务", "无线电", "频率"]
        },
        "_aihot": { "initialBackfillLimit": 20 }
      },
      "tier": "T1",
      "first_party": true,
      "owner_entity_id": "miit",
      "participation_mode": "editorial",
      "interval_minutes": 180,
      "tags": ["官方", "法规"],
      "site_fulltext": false,
      "syndicate_fulltext": false,
      "enabled": true
    },
    {
      "id": "rss-euroncap-news",
      "name": "Euro NCAP News",
      "kind": "rss",
      "config": {
        "feedUrl": "https://news.euroncap.com/rss/",
        "_aihot": { "initialBackfillLimit": 10 }
      },
      "tier": "T1",
      "first_party": true,
      "owner_entity_id": "euro-ncap",
      "participation_mode": "editorial",
      "interval_minutes": 180,
      "tags": ["官方", "测评"],
      "site_fulltext": false,
      "syndicate_fulltext": false,
      "enabled": true
    },
    {
      "id": "json-cncap-pingjia",
      "name": "C-NCAP 测评结果",
      "kind": "json_list",
      "config": {
        "url": "https://www.c-ncap.org.cn/api/getPingjiaList",
        "method": "POST",
        "bodyJson": { "type": "cncap", "size": 20, "current": 1 },
        "itemsPath": "data.data.records",
        "titlePaths": ["title"],
        "urlTemplate": "https://www.c-ncap.org.cn/evaluation/{contentId}",
        "externalIdPath": "contentId",
        "publishedAtPath": "pubTime",
        "_aihot": { "initialBackfillLimit": 20 }
      },
      "tier": "T1",
      "first_party": true,
      "owner_entity_id": "c-ncap",
      "participation_mode": "editorial",
      "interval_minutes": 360,
      "tags": ["官方", "测评"],
      "site_fulltext": false,
      "syndicate_fulltext": false,
      "enabled": true
    },
    {
